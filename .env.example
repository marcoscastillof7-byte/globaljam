# Variables de entorno para GlobalJam Studio
# Copia este archivo como .env y rellena los valores
# NUNCA hagas commit del archivo .env real

# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtén estos valores en: https://supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima-publica-aqui

# ── Netlify (para deploy manual con CLI) ─────────────────────────────────────
# Obtén en: https://app.netlify.com → User settings → Applications
NETLIFY_AUTH_TOKEN=tu-token-de-netlify
NETLIFY_SITE_ID=id-de-tu-sitio-en-netlify
